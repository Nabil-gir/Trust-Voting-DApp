{
  "name": "trust-voting-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test mocha test/Voting.ts",
    "test:voting": "hardhat test mocha test/Voting.ts",
    "voting:abi": "hardhat build && node scripts/sync-voting-abi.mjs",
    "voting:node": "hardhat node --network hardhatMainnet --hostname 127.0.0.1",
    "voting:deploy:local": "hardhat run scripts/deploy-voting.ts --network localhost",
    "voting:deploy:sepolia": "hardhat run scripts/deploy-voting.ts --network sepolia --build-profile production",
    "dapp:local": "node scripts/start-voting-local.mjs",
    "dapp:demo": "node scripts/start-voting-demo.mjs",
    "dapp:dev": "npm --prefix voting-dapp run dev",
    "dapp:build": "npm --prefix voting-dapp run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^18.0.8",
    "viem": "^2.57.14"
  }
}
